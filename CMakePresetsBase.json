{
  "version": 8,
  "configurePresets": [
    {
      "name": "config-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/_bld-${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "HDF_PACKAGE_NAMESPACE": "xpro::",
        "HDF5_BUILD_CPP_LIB": "ON",
        "HDF5_BUILD_HL_LIB": "ON",
        "HDF5_BUILD_TOOLS": "OFF",
        "HDF5_BUILD_UTILS": "OFF",
        "HDF5_ENABLE_SZIP_SUPPORT": "OFF",
        "HDF5_ENABLE_Z_LIB_SUPPORT": "ON",
        "HDF5_INSTALL_DATA_DIR": "share",
        "HDF5_INSTALL_INCLUDE_DIR": "include/hdf5",
        "HDF5_NO_PACKAGES": "ON",
        "XP_NAMESPACE": "xpro"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-base",
      "hidden": true
    }
  ]
}
